# Copy to .env and fill locally. Never commit real values.

DATABASE_URL=
APP_URL=http://localhost:3000
APP_ENV=development

# --- Day 2 — Telegram Mini App identity (REQ-005 / REQ-016) ---
# Server-side only. The bot token is never sent to the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_SECRET=
# Reject init data older than this (seconds). Default 86400 (Telegram's own guidance).
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
# Accept UNSIGNED init data. Honoured only when APP_ENV is development or test
# AND no TELEGRAM_BOT_TOKEN is set. Never enable on staging or production.
TELEGRAM_DEV_AUTH_ENABLED=false

# --- Day 2 — Mobile verification (REQ-018) ---
# DEC-011 is unsigned: verification is OFF by default so checkout is not blocked.
OTP_REQUIRED=false
# DEC-003 has not named an SMS vendor. `none` refuses to send (production default);
# `log` writes the code to the server log and is rejected in production.
PHONE_VERIFICATION_PROVIDER=
OTP_CODE_LENGTH=6
OTP_CODE_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=60

# Day 6 — Bale bot. Leave empty until then.
BALE_BOT_TOKEN=

# --- Day 3 — Admin authentication (REQ-046 / REQ-070) ---
# There is no self-registration. Create the first admin with:
#   npm run admin:create -- --email you@example.com
# The command prompts for the password; never put one in this file or in git.
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

# --- Day 3 — PDF preview (REQ-014) ---
# DEC-006 and DEC-007 are UNSIGNED. These are contractor development defaults,
# not a client-approved page count or watermark. Replace them when the client
# answers; they must not appear in handover as an ordered requirement.
PREVIEW_PAGE_LIMIT=3
PREVIEW_WATERMARK_TEXT=

# --- Day 3 — Object Storage for covers and preview PDFs (REQ-014) ---
# `auto` (default) picks s3 when every credential below is present, a local
# development folder in development/test, and otherwise refuses uploads.
# Staging and production NEVER fall back to local disk: an upload fails loudly
# rather than landing on a container disk the next deploy erases.
OBJECT_STORAGE_PROVIDER=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Liara Object Storage and most S3-compatible hosts need path-style addressing.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Upload ceilings, in bytes.
MAX_COVER_UPLOAD_BYTES=5242880
MAX_PDF_UPLOAD_BYTES=67108864

# Optional — throwaway PostgreSQL for the DB-backed integration tests.
# TEST_DATABASE_URL=

# --- Future placeholders (do not implement yet) ---
# PAYMENT_GATEWAY_MERCHANT_ID=
# PAYMENT_GATEWAY_API_KEY=
# SMS_PROVIDER_API_KEY=
# SMS_SENDER_ID=
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=
